<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mobile_hr_api_audit_log_list" model="ir.ui.view">
        <field name="name">mobile.hr.api.audit.log.list</field>
        <field name="model">mobile.hr.api.audit.log</field>
        <field name="arch" type="xml">
            <list string="API Audit Logs"
                  decoration-danger="status == 'error'"
                  decoration-success="status == 'success'"
                  create="false" edit="false" delete="false">
                <field name="timestamp"/>
                <field name="user_id"/>
                <field name="employee_id"/>
                <field name="action"/>
                <field name="endpoint"/>
                <field name="status"/>
                <field name="ip_address"/>
                <field name="details"/>
            </list>
        </field>
    </record>

    <record id="view_mobile_hr_api_audit_log_form" model="ir.ui.view">
        <field name="name">mobile.hr.api.audit.log.form</field>
        <field name="model">mobile.hr.api.audit.log</field>
        <field name="arch" type="xml">
            <form string="Audit Log Entry" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <field name="timestamp"/>
                        <field name="user_id"/>
                        <field name="employee_id"/>
                        <field name="action"/>
                        <field name="endpoint"/>
                        <field name="status"/>
                        <field name="ip_address"/>
                    </group>
                    <group string="Details">
                        <field name="details" nolabel="1"/>
                    </group>
                    <group string="Extra Data">
                        <field name="extra_data" nolabel="1" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mobile_hr_api_audit_log_search" model="ir.ui.view">
        <field name="name">mobile.hr.api.audit.log.search</field>
        <field name="model">mobile.hr.api.audit.log</field>
        <field name="arch" type="xml">
            <search string="Search Audit Logs">
                <field name="user_id"/>
                <field name="employee_id"/>
                <field name="action"/>
                <field name="ip_address"/>
                <filter name="filter_success" string="Success" domain="[('status', '=', 'success')]"/>
                <filter name="filter_error" string="Errors" domain="[('status', '=', 'error')]"/>
            </search>
        </field>
    </record>

    <record id="action_mobile_hr_api_audit_log" model="ir.actions.act_window">
        <field name="name">API Audit Logs</field>
        <field name="res_model">mobile.hr.api.audit.log</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>

    <menuitem
        id="menu_mobile_hr_api_reporting"
        name="Reporting"
        parent="menu_mobile_hr_api_root"
        sequence="20"
        groups="hr.group_hr_manager"/>

    <menuitem
        id="menu_mobile_hr_api_audit_log"
        name="Audit Logs"
        parent="menu_mobile_hr_api_reporting"
        action="action_mobile_hr_api_audit_log"
        sequence="10"
        groups="hr.group_hr_manager"/>

</odoo>

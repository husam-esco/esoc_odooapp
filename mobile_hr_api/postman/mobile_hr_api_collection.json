                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/mobile/hr/leaves/types",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "mobile", "hr", "leaves", "types"]
            },
            "description": "Returns all active leave types available to the employee's company. The test script saves the first type's ID to `{{leave_type_id}}`."
          }
        },
        {
          "name": "Create Leave Request",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Set dates 30 days from now to avoid conflicts",
                  "const future = new Date();",
                  "future.setDate(future.getDate() + 30);",
                  "const pad = n => String(n).padStart(2, '0');",
                  "const y = future.getFullYear(), m = pad(future.getMonth()+1), d = pad(future.getDate());",
                  "pm.variables.set('leave_date_from', `${y}-${m}-${d}T08:00:00`);",
                  "pm.variables.set('leave_date_to',   `${y}-${m}-${d}T17:00:00`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Leave created (201) or validation error (422)', () => {",
                  "    pm.expect([201, 422, 400]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"leave_type_id\": {{leave_type_id}},\n  \"date_from\": \"{{leave_date_from}}\",\n  \"date_to\": \"{{leave_date_to}}\",\n  \"description\": \"Postman test leave request\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/mobile/hr/leaves",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "mobile", "hr", "leaves"]
            },
            "description": "Submit a leave request. The pre-request script auto-calculates dates 30 days from now.\n\nLeave is created in `confirm` state (pending manager approval).\n\n**Common errors:**\n- `404` — leave_type_id does not exist\n- `422` — allocation exhausted, overlapping leave, or other Odoo validation failure"
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"id\": 55,\n    \"name\": \"Postman test leave request\",\n    \"leave_type\": { \"id\": 1, \"name\": \"Annual Leave\" },\n    \"date_from\": \"2024-07-15T08:00:00\",\n    \"date_to\": \"2024-07-15T17:00:00\",\n    \"number_of_days\": 1.0,\n    \"state\": \"confirm\",\n    \"state_label\": \"To Approve\",\n    \"refuse_reason\": \"\"\n  }\n}"
            }
          ]
        },
        {
          "name": "Leave History",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Leave history returned', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data).to.have.property('records');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/mobile/hr/leaves/history?page=1&limit=30",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "mobile", "hr", "leaves", "history"],
              "query": [
                { "key": "state", "value": null, "disabled": true, "description": "draft | confirm | validate1 | validate | refuse" },
                { "key": "page",  "value": "1" },
                { "key": "limit", "value": "30", "description": "Max 100" }
              ]
            },
            "description": "Paginated leave history for the authenticated employee. Filter by `state` to show only pending, approved, etc."
          }
        }
      ]

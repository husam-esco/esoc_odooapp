                  "    pm.expect(json.data).to.be.an('array');",
                  "    if (json.data.length > 0) {",
                  "        pm.collectionVariables.set('leave_type_id', json.data[0].id);",
                  "        console.log('First leave type:', json.data[0].name, '(id:', json.data[0].id, ')');",
